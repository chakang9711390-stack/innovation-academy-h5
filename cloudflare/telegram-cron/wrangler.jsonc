{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "innovation-academy-tg-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["APP_BASE_URL", "CRON_SECRET"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
